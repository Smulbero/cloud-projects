{
  "properties": {
    "displayName": "Restrict resource deployments to allowed regions",
    "policyType": "Custom",
    "mode": "All",
    "description": "Denies resource deployment outside of approved locations",
    "metadata": {
      "version": "1.0.0",
      "category": "Location"
    },
    "version": "1.0.0",
    "policyRule": {
      "if": {
        "not": {
          "field": "location",
          "in": [
            "northeurope",
            "westeurope"
          ]
        }
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}