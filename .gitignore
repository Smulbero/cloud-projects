# draw.io backup files
*.bkp

# Any log files
*.log
*/logs

# -----------------------------------------------------
# Terraform
# -----------------------------------------------------
# Local .terraform directories
**/.terraform/*
**/.terraform*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as password, private keys, and other secrets.
# These don't contain anything sensitive in this case since they are for demonstration purposes only
# *.tfvars 
*.tfvars.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*